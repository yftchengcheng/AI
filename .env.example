# 环境变量模板 — 复制到 .env.local 填入真实值
# 开发阶段不需要，本地 mock 即可运行

# DeepSeek API
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 数据库 (本地开发可注释掉，自动回退 SQLite)
DATABASE_URL=postgresql://user:password@host:5432/ai_tool_platform

# 阿里云 OSS (构建产物存储)
OSS_ENDPOINT=oss-cn-xxx.aliyuncs.com
OSS_BUCKET=ai-tool-platform
OSS_ACCESS_KEY_ID=your_id
OSS_ACCESS_KEY_SECRET=your_secret

# NextAuth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_random_string
