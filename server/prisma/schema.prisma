generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── 用户 ──────────────────────────────────────────

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  username  String
  password  String
  avatarUrl String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  projects          Project[]
  tokens            ApiToken[]
  diagnosticReports DiagnosticReport[]

  @@map("users")
}

// ── API Token ─────────────────────────────────────

model ApiToken {
  id     String @id @default(uuid())
  name   String
  key    String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("api_tokens")
}

// ── 项目 ──────────────────────────────────────────

model Project {
  id          String   @id @default(uuid())
  userId      String
  name        String
  type        ToolType
  status      ProjectStatus @default(draft)
  description String   @default("")
  config      Json     @default("{}")
  outputUrl   String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user            User               @relation(fields: [userId], references: [id])
  marketplaceTool MarketplaceTool?

  @@map("projects")
}

enum ToolType {
  app
  miniapp
  web
  skill
  agent
}

enum ProjectStatus {
  draft
  building
  done
  failed
}

// ── 市场工具 ──────────────────────────────────────

model MarketplaceTool {
  id          String   @id @default(uuid())
  projectId   String   @unique
  userId      String
  name        String
  description String
  category    ToolType
  tags        String[] @default([])
  downloads   Int      @default(0)
  rating      Float    @default(0.0)
  version     String   @default("1.0.0")
  status      MarketStatus @default(pending)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id])

  @@map("marketplace_tools")
}

enum MarketStatus {
  pending
  approved
  rejected
}

// ── 诊断报告 ──────────────────────────────────────

model DiagnosticReport {
  id        String           @id @default(uuid())
  userId    String
  type      DiagnosticType
  input     String
  result    Json?
  status    DiagnosticStatus @default(pending)
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("diagnostic_reports")
}

enum DiagnosticType {
  error
  perf
  dependency
  log
}

enum DiagnosticStatus {
  pending
  analyzing
  done
  failed
}
